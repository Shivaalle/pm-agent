# ==============================================================================
# SECRETS + RUNTIME OVERRIDES
# Copy to .env. Non-secret defaults live in backend/config/settings.yaml.
# ==============================================================================

# --- AI provider --------------------------------------------------------------
# gemini | openai_compatible | mock
AI_PROVIDER="gemini"
GEMINI_API_KEY="your-gemini-api-key"
# Optional model overrides
# GEMINI_TEXT_MODEL="gemini-3.5-flash-lite"
# GEMINI_TEXT_BACKUP="gemini-3.7-flash"

# Offline/explicit mock mode only. Never silently substitutes fake output.
# AI_PROVIDER="mock"
# AI_ALLOW_MOCK_FALLBACK="false"

# Self-hosted / OpenAI-compatible server (Ollama, vLLM, LM Studio, etc.)
# AI_PROVIDER="openai_compatible"
# OPENAI_BASE_URL="http://localhost:11434/v1"
# OPENAI_MODEL="qwen2.5:14b"
# OPENAI_API_KEY="optional-for-local-servers"

# --- Atlassian Jira Cloud -----------------------------------------------------
JIRA_BASE_URL="https://your-domain.atlassian.net"
JIRA_EMAIL="your-email@example.com"
JIRA_API_TOKEN="your-atlassian-api-token"
# JIRA_PROJECT_KEY="KAN"

# --- GitHub ------------------------------------------------------------------
GITHUB_TOKEN="your-github-personal-access-token"
GITHUB_REPO="owner/repo-name"

# --- Microsoft Teams / Graph (optional) --------------------------------------
# Either a short-lived token or an app registration for client credentials.
# TEAMS_ACCESS_TOKEN=""
# TEAMS_TENANT_ID=""
# TEAMS_CLIENT_ID=""
# TEAMS_CLIENT_SECRET=""
# TEAMS_USER_ID="user@example.com"

# --- Runtime ------------------------------------------------------------------
# APP_ENV="development"
# DEMO_PASSWORD="demo1234"
# SESSION_TTL_HOURS="24"
# SCHEDULER_ENABLED="true"
# ALERT_SCAN_INTERVAL_SECONDS="60"
# PM_DB_PATH="./data/agent.db"
# CONNECTORS_ALLOW_MOCK="true"   # only used when connector credentials are absent

# Comma-separated origins for the Vite dev server
# CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"
